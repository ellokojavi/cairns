<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Hike planner" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Mailbox Peak, Old Trail</name>
    <desc>Mailbox Peak trailhead to the summit and back by the Old Trail. 7.5 km, +1,207 m, −1,207 m.</desc>
  </metadata>
  <wpt lat="47.466015" lon="-121.672618">
    <ele>267.0</ele>
    <name>1 Trailhead</name>
    <desc>Discover Pass on the dashboard. Carry all your water: 2 L each. Poles help a lot on this trail, mostly on the way down.</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <wpt lat="47.462621" lon="-121.673644">
    <ele>302.6</ele>
    <name>2 Old Trail sign</name>
    <desc>Leave the gravel road here for the Old Trail. From now on it barely lets up: no switchbacks, root steps up to knee height.</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <wpt lat="47.460843" lon="-121.655743">
    <ele>871.8</ele>
    <name>3 Halfway up, 870 m</name>
    <desc>Half the height in 2 km. Average grade so far is over 30%. Eat now.</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <wpt lat="47.462362" lon="-121.647163">
    <ele>1223.9</ele>
    <name>4 New Trail junction</name>
    <desc>The New Trail joins from the left. Last 0.8 km and 250 m: the boulder field, with built steps. Layer up before it.</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <wpt lat="47.462409" lon="-121.639280">
    <ele>1474.0</ele>
    <name>5 Summit, the mailbox</name>
    <desc>Sign the register in the mailbox. Dry layer and shell before you sit. Decide here: down the Old Trail (2 h, steep), or the New Trail (+4.2 km, about 30 min longer, far kinder to knees).</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <wpt lat="47.462362" lon="-121.647163">
    <ele>1223.9</ele>
    <name>6 New Trail junction (down)</name>
    <desc>Straight on for the Old Trail. Shorten poles, small steps, face in on the root steps. Most injuries here happen going down.</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <wpt lat="47.460843" lon="-121.655743">
    <ele>871.8</ele>
    <name>7 Halfway down, 870 m</name>
    <desc>Half the descent. Knees and quads: slow is fine, falls are not.</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <wpt lat="47.462621" lon="-121.673644">
    <ele>302.6</ele>
    <name>8 Old Trail sign (down)</name>
    <desc>Back on the gravel road. Ten easy minutes to the car.</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <wpt lat="47.466015" lon="-121.672618">
    <ele>267.0</ele>
    <name>9 Trailhead</name>
    <desc>Finish. Back at the car.</desc>
    <sym>Flag, Blue</sym>
    <type>Milestone</type>
  </wpt>
  <trk>
    <name>Mailbox Peak, Old Trail</name>
